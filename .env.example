# ==============================================================================
# ThinkUp Happy December – Best Kids' Apps Challenge Configuration
# ==============================================================================

# --- Server-Side Pricing (Source of Truth) ---
# The registration fee per participant in Nigerian Naira (NGN).
# All payment amounts are determined server-side from this value (converted to kobo).
REGISTRATION_FEE_NGN=5000
NEXT_PUBLIC_REGISTRATION_FEE_NGN=5000

# --- Base Application URL ---
APP_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# --- Paystack Payment Gateway ---
# Obtain these from your Paystack Dashboard (Settings -> API Keys & Webhooks).
# Live secret keys begin with sk_live_ and test keys begin with sk_test_
# Keep PAYSTACK_SECRET_KEY strictly on the server; NEVER expose it client-side.
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Optional: Dedicated webhook signing secret if configured separately in Paystack Dashboard.
# If omitted, PAYSTACK_SECRET_KEY is used automatically for HMAC-SHA512 verification.
PAYSTACK_WEBHOOK_SECRET=

# --- Development / Local Mock Simulation ---
# Set to 'true' ONLY in non-production local development to simulate verified checkout flows
# when Paystack API keys are pending. This flag is strictly ignored if NODE_ENV=production.
ALLOW_DEV_MOCK_PAYMENT=true

# --- Email Confirmation Service ---
# Option 1: Resend (Recommended)
RESEND_API_KEY=
EMAIL_FROM="ThinkUp Innovation Hub <events@thinkupinnovations.com>"

# Option 2: Custom SMTP (Alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Initial Admin Setup ---
# Run `npm run seed:admin` to create the first admin user, or customize arguments:
# node scripts/seed-admin.mjs [username] [email] [password] [fullName]

